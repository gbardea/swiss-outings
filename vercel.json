{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/voice.js": {
      "maxDuration": 60
    },
    "api/voice-warm.js": {
      "maxDuration": 60
    },
    "api/plan.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/voice-warm",
      "schedule": "40 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/e/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/t/:token",
      "destination": "/api/share?trip=:token"
    }
  ]
}